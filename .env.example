# API origin as the BROWSER sees it (no trailing slash, no /api path).
# Used to build image/upload URLs.
VITE_API_BASE_URL=http://localhost:3000

# Full API base including the version prefix. Used by the axios client.
VITE_APP_API_BASE_URL=http://localhost:3000/api/v1

# Stripe publishable key (safe to expose in the browser).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
